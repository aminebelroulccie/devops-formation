# Copier en terraform.tfvars et adapter.
# terraform.tfvars n'est pas commité (voir .gitignore).

owner            = "formini-a1"
region           = "eu-west-3"
instance_type    = "t3.micro"
public_key_path  = "~/.ssh/id_ed25519.pub"

# Votre IP publique en /32 (curl -s ifconfig.me) ; 0.0.0.0/0 pour la formation.
ssh_allowed_cidr = "0.0.0.0/0"
